generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shops — Section 6
// ---------------------------------------------------------------------------

model Shop {
  id                  String    @id @default(cuid())
  shopDomain          String    @unique @map("shop_domain")
  encryptedAccessToken String   @map("encrypted_access_token")
  scopes              String
  installedAt         DateTime  @default(now()) @map("installed_at")
  uninstalledAt       DateTime? @map("uninstalled_at")

  catalogUploads   CatalogUpload[]
  catalogs         Catalog[]
  importOperations ImportOperation[]
  variantMappings  CatalogVariantMapping[]
  supplierProfiles SupplierProfile[]
  productMappings  ProductMapping[]
  catalogRuns      CatalogRun[]
  shopifySyncs     ShopifyCatalogSync[]
  shopifyProducts  ShopifyProductSnapshot[]

  @@map("shops")
}

// ---------------------------------------------------------------------------
// Catalog Uploads
// ---------------------------------------------------------------------------

enum UploadStatus {
  pending
  parsing
  parsed
  failed
}

enum UploadModeEnum {
  CATALOG_UPDATE
  INVENTORY_UPDATE
}

model CatalogUpload {
  id         String          @id @default(cuid())
  shopId     String          @map("shop_id")
  fileName   String          @map("file_name")
  storageKey String          @map("storage_key")
  format     String          // "csv" | "xlsx"
  status     UploadStatus    @default(pending)
  /// Catalog Update = full-snapshot semantics (create/update/detect-missing).
  /// Inventory Update = partial semantics (update supplied fields only, never create).
  uploadMode UploadModeEnum  @default(CATALOG_UPDATE) @map("upload_mode")
  createdAt  DateTime        @default(now()) @map("created_at")

  shop     Shop      @relation(fields: [shopId], references: [id])
  catalogs Catalog[]

  @@index([shopId])
  @@map("catalog_uploads")
}

// ---------------------------------------------------------------------------
// Catalogs
// ---------------------------------------------------------------------------

model Catalog {
  id                String   @id @default(cuid())
  shopId            String   @map("shop_id")
  uploadId          String   @map("upload_id")
  schemaFingerprint String   @map("schema_fingerprint")
  parseVersion      String   @default("1") @map("parse_version")
  /// Resolved vendor — set during vendor-confirm step, null if skipped.
  vendorId          String?  @map("vendor_id")
  createdAt         DateTime @default(now()) @map("created_at")

  shop            Shop             @relation(fields: [shopId], references: [id])
  upload          CatalogUpload    @relation(fields: [uploadId], references: [id])
  vendor          SupplierProfile? @relation(fields: [vendorId], references: [id])
  fieldMappings   FieldMapping[]
  catalogProducts CatalogProduct[]
  importOperations ImportOperation[]
  overrides       CatalogOverride[]
  snapshots       ImportSnapshot[]

  @@index([shopId])
  @@index([vendorId])
  @@map("catalogs")
}

// ---------------------------------------------------------------------------
// Field Mappings — Section 8
// ---------------------------------------------------------------------------

enum MappingSourceEnum {
  rule
  model
  user
}

model FieldMapping {
  id           String            @id @default(cuid())
  catalogId    String            @map("catalog_id")
  sourceColumn String            @map("source_column")
  targetField  String?           @map("target_field")
  confidence   String            // "high" | "medium" | "low"
  mappingSource MappingSourceEnum @map("mapping_source")
  ignored      Boolean           @default(false)

  catalog Catalog @relation(fields: [catalogId], references: [id])

  @@index([catalogId])
  @@map("field_mappings")
}

// ---------------------------------------------------------------------------
// Catalog Products
// ---------------------------------------------------------------------------

enum ProductStatus {
  pending
  ready
  needs_review
  blocked
}

model CatalogProduct {
  id             String        @id @default(cuid())
  catalogId      String        @map("catalog_id")
  sourceKey      String        @map("source_key")
  normalizedJson Json          @map("normalized_json")
  status         ProductStatus @default(pending)

  catalog   Catalog           @relation(fields: [catalogId], references: [id])
  overrides CatalogOverride[]

  @@index([catalogId])
  @@unique([catalogId, sourceKey])
  @@map("catalog_products")
}

// ---------------------------------------------------------------------------
// Import Operations — Section 13-15
// ---------------------------------------------------------------------------

enum ImportOperationStatus {
  planned
  in_progress
  completed
  failed
  cancelled
}

model ImportOperation {
  id              String                @id @default(cuid())
  shopId          String                @map("shop_id")
  catalogId       String                @map("catalog_id")
  status          ImportOperationStatus @default(planned)
  idempotencyKey  String                @unique @map("idempotency_key")
  plannedCount    Int                   @default(0) @map("planned_count")
  successCount    Int                   @default(0) @map("success_count")
  failedCount     Int                   @default(0) @map("failed_count")
  skippedCount    Int                   @default(0) @map("skipped_count")
  createdAt       DateTime              @default(now()) @map("created_at")
  completedAt     DateTime?             @map("completed_at")

  shop    Shop         @relation(fields: [shopId], references: [id])
  catalog Catalog      @relation(fields: [catalogId], references: [id])
  items   ImportItem[]
  snapshot ImportSnapshot?

  @@index([shopId])
  @@map("import_operations")
}

// ---------------------------------------------------------------------------
// Import Items — per-product result tracking
// ---------------------------------------------------------------------------

enum ImportItemAction {
  create
  update
  skip
}

enum ImportItemStatus {
  pending
  success
  failed
  skipped
}

model ImportItem {
  id                String           @id @default(cuid())
  importOperationId String           @map("import_operation_id")
  sourceProductKey  String           @map("source_product_key")
  action            ImportItemAction
  status            ImportItemStatus @default(pending)
  shopifyProductId  String?          @map("shopify_product_id")
  errorCode         String?          @map("error_code")
  errorMessage      String?          @map("error_message")

  importOperation ImportOperation @relation(fields: [importOperationId], references: [id])

  @@index([importOperationId])
  @@map("import_items")
}

// ---------------------------------------------------------------------------
// Catalog Overrides — temporary draft edits (Inline Edit UX)
// ---------------------------------------------------------------------------

enum OverrideSource {
  user
  bulk_rule
  auto_fix
}

model CatalogOverride {
  id         String         @id @default(cuid())
  catalogId  String         @map("catalog_id")
  productId  String         @map("product_id")
  field      String         // dot-path e.g. "title", "variants[0].price"
  oldValue   Json?          @map("old_value")
  newValue   Json           @map("new_value")
  source     OverrideSource
  createdAt  DateTime       @default(now()) @map("created_at")

  catalog Catalog        @relation(fields: [catalogId], references: [id])
  product CatalogProduct @relation(fields: [productId], references: [id])

  @@index([catalogId])
  @@index([productId])
  @@index([catalogId, productId])
  @@map("catalog_overrides")
}

// ---------------------------------------------------------------------------
// Import Snapshots — permanent record of applied edits at import time
// ---------------------------------------------------------------------------

model ImportSnapshot {
  id                  String          @id @default(cuid())
  importOperationId   String          @unique @map("import_operation_id")
  catalogId           String          @map("catalog_id")
  appliedOverrides    Json            @map("applied_overrides") // collapsed diff
  resolvedProductCount Int            @map("resolved_product_count")
  createdAt           DateTime        @default(now()) @map("created_at")

  importOperation ImportOperation @relation(fields: [importOperationId], references: [id])
  catalog         Catalog         @relation(fields: [catalogId], references: [id])

  @@index([catalogId])
  @@map("import_snapshots")
}

// ---------------------------------------------------------------------------
// Catalog Variant Mappings — SKU Persistence Layer
//
// Persists source→Shopify variant identity after successful writes.
// SKU is an attribute of the mapping, not the primary identity.
// A source variant can remain mapped to the same Shopify variant even when
// its supplier SKU is missing, generated, changed, or different from the
// Shopify SKU.
// ---------------------------------------------------------------------------

enum SkuSourceEnum {
  SUPPLIER
  MERCHANT
  STOREDELIVERY_GENERATED
  NONE
}

model CatalogVariantMapping {
  id                       String        @id @default(cuid())
  shopId                   String        @map("shop_id")
  sourceProductKey         String        @map("source_product_key")
  sourceVariantKey         String        @map("source_variant_key")
  sourceVariantFingerprint String        @map("source_variant_fingerprint")
  shopifyProductId         String        @map("shopify_product_id")
  shopifyVariantId         String        @map("shopify_variant_id")

  /// Supplier-provided SKU (from the source file). Null if absent.
  sourceSku                String?       @map("source_sku")
  /// SKU currently on the Shopify variant. Null if none.
  shopifySku               String?       @map("shopify_sku")
  /// Where the Shopify SKU originated.
  skuSource                SkuSourceEnum @map("sku_source")

  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id])

  /// One mapping per source variant per shop — upsert on retry.
  @@unique([shopId, sourceVariantFingerprint])
  @@index([shopId])
  @@index([shopId, sourceProductKey])
  @@index([shopifyVariantId])
  @@map("catalog_variant_mappings")
}

// ---------------------------------------------------------------------------
// Supplier Profiles — recurring supplier/source identity
// ---------------------------------------------------------------------------

model SupplierProfile {
  id                String   @id @default(cuid())
  shopId            String   @map("shop_id")
  name              String
  /// URL-safe slug, e.g. "acme-distribution". Unique per shop.
  normalizedName    String   @map("normalized_name")
  schemaFingerprint String?  @map("schema_fingerprint")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop               Shop                 @relation(fields: [shopId], references: [id])
  productMappings    ProductMapping[]
  catalogRuns        CatalogRun[]
  vendorColumnMappings VendorColumnMapping[]
  catalogs           Catalog[]

  @@unique([shopId, normalizedName])
  @@index([shopId])
  @@index([shopId, schemaFingerprint])
  @@map("supplier_profiles")
}

// ---------------------------------------------------------------------------
// Vendor Column Mappings — per-vendor saved column schema
// Saved only after a successful Catalog Update.
// Reloaded as suggestions for subsequent uploads from the same vendor.
// ---------------------------------------------------------------------------

model VendorColumnMapping {
  id              String   @id @default(cuid())
  vendorId        String   @map("vendor_id")
  sourceColumn    String   @map("source_column")
  canonicalField  String?  @map("canonical_field")
  ignored         Boolean  @default(false)
  /// Reserved for future value transforms (prefix strip, multiplier, etc.)
  transformConfig Json?    @map("transform_config")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendor SupplierProfile @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, sourceColumn])
  @@index([vendorId])
  @@map("vendor_column_mappings")
}

// ---------------------------------------------------------------------------
// Product Mappings — source product ↔ Shopify product identity
// ---------------------------------------------------------------------------

enum MappingStatusEnum {
  MAPPED
  CANDIDATE_MATCH
  AMBIGUOUS
  UNMAPPED
}

enum MatchConfidenceEnum {
  HIGH
  MEDIUM
  LOW
}

model ProductMapping {
  id                       String              @id @default(cuid())
  shopId                   String              @map("shop_id")
  supplierProfileId        String              @map("supplier_profile_id")

  sourceProductKey         String              @map("source_product_key")
  sourceProductFingerprint String              @map("source_product_fingerprint")

  shopifyProductId         String?             @map("shopify_product_id")

  mappingStatus            MappingStatusEnum   @map("mapping_status")
  matchMethod              String?             @map("match_method")
  confidence               MatchConfidenceEnum?

  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  lastSeenAt               DateTime            @default(now()) @map("last_seen_at")

  shop            Shop              @relation(fields: [shopId], references: [id])
  supplierProfile SupplierProfile   @relation(fields: [supplierProfileId], references: [id])
  variantMappings VariantMapping[]

  @@unique([supplierProfileId, sourceProductKey])
  @@index([shopId])
  @@index([supplierProfileId])
  @@index([shopifyProductId])
  @@map("product_mappings")
}

// ---------------------------------------------------------------------------
// Variant Mappings — source variant ↔ Shopify variant identity
//
// Replaces the flat CatalogVariantMapping with a hierarchical model
// under ProductMapping for proper reconciliation.
// ---------------------------------------------------------------------------

model VariantMapping {
  id                       String              @id @default(cuid())
  productMappingId         String              @map("product_mapping_id")

  sourceVariantKey         String              @map("source_variant_key")
  sourceVariantFingerprint String              @map("source_variant_fingerprint")

  sourceSku                String?             @map("source_sku")
  barcode                  String?
  mpn                      String?

  shopifyVariantId         String?             @map("shopify_variant_id")
  shopifySku               String?             @map("shopify_sku")
  skuSource                SkuSourceEnum       @map("sku_source")

  matchMethod              String?             @map("match_method")
  confidence               MatchConfidenceEnum?

  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  lastSeenAt               DateTime            @default(now()) @map("last_seen_at")

  productMapping ProductMapping @relation(fields: [productMappingId], references: [id])

  @@unique([productMappingId, sourceVariantFingerprint])
  @@index([productMappingId])
  @@index([shopifyVariantId])
  @@map("variant_mappings")
}

// ---------------------------------------------------------------------------
// Catalog Runs — per-upload reconciliation history
// ---------------------------------------------------------------------------

enum CatalogRunStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model CatalogRun {
  id                  String           @id @default(cuid())
  supplierProfileId   String           @map("supplier_profile_id")
  shopId              String           @map("shop_id")
  catalogId           String?          @map("catalog_id")
  sourceFileHash      String?          @map("source_file_hash")
  schemaFingerprint   String?          @map("schema_fingerprint")
  status              CatalogRunStatus @default(IN_PROGRESS)

  /// Summary counts
  totalProducts       Int              @default(0) @map("total_products")
  mappedCount         Int              @default(0) @map("mapped_count")
  matchedCount        Int              @default(0) @map("matched_count")
  newCount            Int              @default(0) @map("new_count")
  reviewCount         Int              @default(0) @map("review_count")

  startedAt           DateTime         @default(now()) @map("started_at")
  completedAt         DateTime?        @map("completed_at")

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id])
  shop            Shop            @relation(fields: [shopId], references: [id])
  items           RunItem[]

  @@index([supplierProfileId])
  @@index([shopId])
  @@map("catalog_runs")
}

// ---------------------------------------------------------------------------
// Run Items — per-product reconciliation result within a run
// ---------------------------------------------------------------------------

enum ReconciliationClassification {
  EXISTING_MAPPED
  LIKELY_EXISTING
  NEW_PRODUCT
  NEEDS_REVIEW
  UPDATE_REVIEW
  NO_CHANGE
  MISSING
}

enum ProposedActionEnum {
  CREATE_PRODUCT
  CREATE_VARIANT
  UPDATE_PRODUCT
  LINK_EXISTING_PRODUCT
  LINK_EXISTING_VARIANT
  NO_CHANGE
  SKIP
}

model RunItem {
  id                    String                       @id @default(cuid())
  catalogRunId          String                       @map("catalog_run_id")

  sourceProductKey      String                       @map("source_product_key")
  classification        ReconciliationClassification
  proposedAction        ProposedActionEnum           @map("proposed_action")

  productMappingId      String?                      @map("product_mapping_id")
  matchedShopifyId      String?                      @map("matched_shopify_id")
  confidence            MatchConfidenceEnum?
  matchEvidence         Json?                        @map("match_evidence")

  merchantConfirmed     Boolean                      @default(false) @map("merchant_confirmed")

  catalogRun CatalogRun @relation(fields: [catalogRunId], references: [id])

  @@index([catalogRunId])
  @@unique([catalogRunId, sourceProductKey])
  @@map("run_items")
}

// ---------------------------------------------------------------------------
// Shopify Catalog Sync — bootstrap read model
//
// Persists a snapshot of the merchant's existing Shopify products/variants
// for matching during reconciliation. Only stores fields needed for identity.
// ---------------------------------------------------------------------------

enum SyncStatus {
  NOT_SYNCED
  SYNCING
  READY
  FAILED
  STALE
}

model ShopifyCatalogSync {
  id            String     @id @default(cuid())
  shopId        String     @map("shop_id")
  status        SyncStatus @default(NOT_SYNCED)
  productCount  Int        @default(0) @map("product_count")
  variantCount  Int        @default(0) @map("variant_count")
  errorCount    Int        @default(0) @map("error_count")
  errorMessage  String?    @map("error_message")
  startedAt     DateTime   @default(now()) @map("started_at")
  completedAt   DateTime?  @map("completed_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([shopId, status])
  @@map("shopify_catalog_syncs")
}

model ShopifyProductSnapshot {
  id                 String   @id @default(cuid())
  shopId             String   @map("shop_id")
  shopifyProductId   String   @map("shopify_product_id")
  title              String
  handle             String?
  vendor             String?
  status             String?  // active, draft, archived
  updatedAtShopify   DateTime? @map("updated_at_shopify")
  syncedAt           DateTime  @default(now()) @map("synced_at")

  shop     Shop                      @relation(fields: [shopId], references: [id])
  variants ShopifyVariantSnapshot[]

  @@unique([shopId, shopifyProductId])
  @@index([shopId])
  @@index([shopId, handle])
  @@map("shopify_product_snapshots")
}

model ShopifyVariantSnapshot {
  id                 String   @id @default(cuid())
  shopifyVariantId   String   @map("shopify_variant_id")
  shopifyProductId   String   @map("shopify_product_id")
  productSnapshotId  String   @map("product_snapshot_id")

  sku                String?
  barcode            String?

  option1            String?
  option2            String?
  option3            String?

  inventoryItemId    String?  @map("inventory_item_id")
  updatedAtShopify   DateTime? @map("updated_at_shopify")
  syncedAt           DateTime  @default(now()) @map("synced_at")

  productSnapshot ShopifyProductSnapshot @relation(fields: [productSnapshotId], references: [id], onDelete: Cascade)

  @@unique([productSnapshotId, shopifyVariantId])
  @@index([productSnapshotId])
  @@index([sku])
  @@index([barcode])
  @@map("shopify_variant_snapshots")
}

// ---------------------------------------------------------------------------
// Update Selections — merchant's per-field update choices
// ---------------------------------------------------------------------------

enum UpdateSelectionStatus {
  PENDING
  APPLIED
  FAILED
  SKIPPED
}

model UpdateSelection {
  id                String                @id @default(cuid())
  catalogRunId      String                @map("catalog_run_id")
  sourceProductKey  String                @map("source_product_key")
  shopifyProductId  String                @map("shopify_product_id")
  selectedFields    Json                  @map("selected_fields")
  status            UpdateSelectionStatus @default(PENDING)
  errorMessage      String?               @map("error_message")
  appliedAt         DateTime?             @map("applied_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  @@unique([catalogRunId, sourceProductKey])
  @@index([catalogRunId])
  @@map("update_selections")
}
