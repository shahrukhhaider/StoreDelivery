{
  "name": "storekeeper",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Shopify Supplier Catalog Importer \u2014 upload supplier spreadsheets, review mappings, import new products",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite dev\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite dev",
    "build": "npm run build:server && npm run build:client && npm run db:generate",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build:client": "vite build",
    "clean": "rm -rf dist node_modules/.cache coverage",
    "clean:all": "rm -rf dist node_modules/.cache coverage node_modules package-lock.json",
    "postinstall": "./node_modules/.bin/prisma generate || node_modules/.bin/prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "./node_modules/.bin/prisma generate",
    "db:migrate": "./node_modules/.bin/prisma migrate dev",
    "db:push": "./node_modules/.bin/prisma db push",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@prisma/client": "6.19.3",
    "@shopify/app-bridge-react": "^4.0.0",
    "@shopify/polaris": "^13.0.0",
    "@shopify/shopify-api": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "multer": "^2.3.0",
    "nanoid": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsc-alias": "^1.9.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "winston": "^3.17.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "vitest": "^3.0.0"
  }
}
