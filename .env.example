# Shopify App
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_products,read_products
SHOPIFY_APP_URL=https://localhost:3000
SHOPIFY_AUTH_CALLBACK_PATH=/api/auth/callback

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/storekeeper

# File Storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=storekeeper-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# Upload Limits
MAX_UPLOAD_SIZE_MB=50
RAW_FILE_RETENTION_DAYS=30

# LLM (for mapping inference)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
